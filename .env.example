# --- Agent backend mode ---
# mock  = deterministic generic engine (development)
# demo  = deterministic demo scenarios (live presentations; no external calls)
# real  = forward conversation to the n8n Agent webhook
N8N_MODE=demo

# --- Real n8n connection (required only when N8N_MODE=real) ---
# Production webhook URL of the "Tap to Automate — Discovery Agent" workflow.
# Never expose this to the browser.
N8N_WEBHOOK_URL=
# Shared secret sent as `x-webhook-secret`; validate it inside the n8n workflow.
N8N_WEBHOOK_SECRET=

# Required for blueprint email delivery and build-request capture.
# The app reports delivery unavailable when this or the shared secret is absent.
N8N_LEAD_WEBHOOK_URL=
